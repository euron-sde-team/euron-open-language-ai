# Generated by `make env` (scripts/gen-local-env.sh) with random values. Local only.
LANG_JWT_SECRET=replace-with-output-of-make-env
LANG_REFRESH_SECRET=replace-with-output-of-make-env
# 32 random bytes, base64 (openssl rand -base64 32): encrypts stored TOTP secrets.
LANG_TOTP_ENCRYPTION_KEY=replace-with-output-of-make-env
# Every demo account (make demo) signs in with this password.
LANG_DEMO_PASSWORD=replace-with-output-of-make-env

# Real model providers (optional: `make demo` registers the "Stub" provider, which
# needs no key). Realtime voice practice need OPENAI_API_KEY (OpenAI Realtime) or
# GEMINI_API_KEY (Gemini Live); lesson reports use any text provider. Either one
# JSON object keyed by provider slug ...
# PROVIDER_KEYS={"openai":"sk-...","gemini":"...","anthropic":"sk-ant-..."}
# ... or the single-key shortcuts (PROVIDER_KEYS wins when both name a provider):
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
# GROQ_API_KEY=gsk_...

# Where realtime credentials are minted (defaults: the real OpenAI and Gemini APIs).
# The stubs' fake endpoints, as the tests use:
# OPENAI_REALTIME_URL=http://stubs:5209/v1
# GEMINI_LIVE_URL=http://stubs:5209/gemini/v1alpha
# Origins the browser may open realtime voice connections to (the web CSP's
# connect-src; space separated). Default: Gemini Live's WebSocket host.
# REALTIME_ORIGINS=wss://generativelanguage.googleapis.com

# Optional overrides (host ports and names)
# LANG_PRODUCT_NAME=Euron Open Language AI
# LANG_LOG_LEVEL=info
# LANG_WEB_PORT=3640
# LANG_API_PORT=5116
# LANG_PG_PORT=5562
# LANG_REDIS_PORT=6499
# LANG_MAILPIT_PORT=8116
# LANG_SMTP_PORT=1116
# LANG_FLOCI_PORT=4667
# LANG_STUB_PORT=5209
